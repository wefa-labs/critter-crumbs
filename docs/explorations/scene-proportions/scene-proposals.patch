diff --git a/packages/app/src/styles/screens.css b/packages/app/src/styles/screens.css
index f319315..49cb868 100644
--- a/packages/app/src/styles/screens.css
+++ b/packages/app/src/styles/screens.css
@@ -115,3 +115,23 @@ dialog.connect-sheet { max-height:calc(100dvh - 24px); overflow-y:auto; overscro
 /* ------------------------------------------------------------------ while the session is read, a screen's code arrives
    or a route's data is on its way: three bobbing crumbs, filling the screen or waiting under the page's header */
 .opening { display:flex; min-height:40dvh; align-items:center; justify-content:center; }
+
+/* ------------------------------------------------------------------ PROPOSAL (docs/explorations/scene-proportions): the
+   first steps stand in the launcher's room. The painting is drawn at the launcher's zoom (--room-h, its height on screen)
+   and anchored to the floor's foot, so the room does not jump from the launcher to the first steps, and every position
+   and size in learn-steps.ts is in the painting: x and y in percent of it, size in its pixels. */
+.learn .sheet-screen { --room-h:calc(.8 * 100dvh); --room-w:calc(var(--room-h) * 1.7837); }
+@media (min-width:900px) { .learn .sheet-screen { --room-h:max(100vw / 1.7837, 100dvh - 36px); } }
+.learn .screen-floor .scene-paint { background-size:auto var(--room-h); background-position:center bottom; }
+.learn .screen-floor .floor-critter, .learn .screen-floor .floor-prop { left:calc(50% + (var(--x) / 100 - .5) * var(--room-w)); top:calc(100% - (1 - var(--y) / 100) * var(--room-h)); width:calc(var(--size) * var(--room-h) / 897); }
+
+/* ------------------------------------------------------------------ PROPOSAL (docs/explorations/scene-proportions): night
+   grading for critters. The paintings dim under the dusk wash; the critters were still lit as by day and their plum
+   contact shadow vanished on the dark floor. Grade them toward the room (no inversion), and give each a small pool of
+   lamplight to stand in, so they stay grounded and legible. */
+@media (prefers-color-scheme:dark) {
+  :root:not([data-theme="light"]) .portrait { filter:brightness(.86) saturate(.9); }
+  :root:not([data-theme="light"]) .floor-critter::before, :root:not([data-theme="light"]) .stage[data-critter-id]::before { content:''; position:absolute; left:6%; right:6%; top:89%; height:9%; border-radius:50%; background:radial-gradient(closest-side, rgb(255 222 170 / .28), transparent); pointer-events:none; }
+}
+:root[data-theme="dark"] .portrait { filter:brightness(.86) saturate(.9); }
+:root[data-theme="dark"] .floor-critter::before, :root[data-theme="dark"] .stage[data-critter-id]::before { content:''; position:absolute; left:6%; right:6%; top:89%; height:9%; border-radius:50%; background:radial-gradient(closest-side, rgb(255 222 170 / .28), transparent); pointer-events:none; }
