{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@critter-crumbs/shared": ["../../../packages/shared/src/index.ts"],
      "@critter-crumbs/core": ["src/core-shim.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
