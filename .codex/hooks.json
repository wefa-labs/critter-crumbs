{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/block-dangerous-git.sh\"",
            "statusMessage": "Checking for destructive git commands..."
          }
        ]
      }
    ]
  }
}
