{
  "name": "critter-crumbs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.1 <23",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/app",
    "packages/api"
  ],
  "scripts": {
    "dev": "bun run compile && node scripts/dev.mjs",
    "dev:app": "bun run compile && node scripts/dev.mjs --app-only",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "test": "node scripts/test.mjs",
    "compile": "node scripts/generate-tokens.mjs && tsc -b",
    "check:licenses": "bun scripts/check-dependencies.mjs",
    "check:audit": "bun audit --audit-level=high --ignore=GHSA-vfj7-8cjw-p6xm",
    "check": "bun run check:toolchain && bun run check:tokens && bun run lint && bun run typecheck && bun run test && bun run check:development-assets && bun run check:workspaces && bun run check:licenses && bun run check:audit",
    "build": "bun run compile && vite build --config packages/app/vite.config.ts",
    "vercel-build": "PATH=\"$PWD/.vercel/bun/bin:$PATH\" .vercel/bun/bin/bun run build",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "migrate": "bun run compile && bun run compile:server && node --env-file-if-exists=.env .scratch/server/scripts/migrate.js",
    "seed": "bun run compile && bun run compile:server && node --env-file-if-exists=.env .scratch/server/scripts/seed.js",
    "check:workspaces": "node scripts/probe-workspaces.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:development-assets": "node --test scripts/development-assets.test.mjs",
    "compile:server": "tsc -p tsconfig.server.json",
    "dev:local": "bun run compile && bun run compile:server && node --env-file-if-exists=.env scripts/dev.mjs --local",
    "register-schemas": "bun run compile && bun run compile:server && node --env-file-if-exists=.env .scratch/server/scripts/register-schemas.js",
    "test:api:neon": "node --env-file-if-exists=.env scripts/test-neon.mjs",
    "check:shutter": "bun run compile && bun run compile:server && node --env-file-if-exists=.env .scratch/server/scripts/check-shutter.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "screens:capture": "playwright test --config playwright.capture.config.ts",
    "demo:record": "playwright test --config playwright.demo.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@ethereum-attestation-service/eas-sdk": "2.10.0",
    "@noble/curves": "1.9.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vercel": "59.9.1",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "path-to-regexp@6.1.0": "6.3.0",
    "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
    "undici@5": "6.28.1",
    "tar@7.5.7": "7.5.22",
    "adm-zip@0.4.16": "0.6.1",
    "serialize-javascript@6.0.2": "7.1.0",
    "tmp@0.0.33": "0.2.7",
    "minimatch@10.1.1": "10.2.6",
    "js-yaml@4.1.1": "4.3.2",
    "smol-toml@<=1.7.0": "1.7.2",
    "brace-expansion@<1.1.20": "1.1.20",
    "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
    "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
    "undici@>=6.7.0 <6.28.1": "6.28.1",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
  },
  "dependencies": {
    "@critter-crumbs/core": "0.0.0",
    "@critter-crumbs/shared": "0.0.0",
    "@critter-crumbs/api": "0.0.0"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "koota@0.6.6": "patches/koota@0.6.6.patch",
    "@shutter-network/shutter-sdk@0.0.2": "patches/@shutter-network%2Fshutter-sdk@0.0.2.patch"
  }
}
